# .env.example - Template for environment variables
# Copy this file to .env and fill in your actual values
# NEVER commit .env with actual values!

# Test Credentials (Local Development Only)
APP_USERNAME=standard_user
APP_PASSWORD=secret_sauce

# Grid Configuration (optional)
GRID_URL=http://localhost:4444

# Environment Selection
ENV=dev
# Options: dev, staging, prod

# Browser Selection (for local testing)
BROWSER=edge
# Options: chrome, firefox, edge

# Timeouts (in seconds)
IMPLICIT_WAIT=5
EXPLICIT_WAIT=15

# Screenshot Path
SCREENSHOT_PATH=target/screenshots/

# Allure Report
ALLURE_RESULTS_PATH=target/allure-results/
