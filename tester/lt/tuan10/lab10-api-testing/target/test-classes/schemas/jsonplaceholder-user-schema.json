{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "required": ["id", "name", "username", "email", "address"],
    "additionalProperties": true,
    "properties": {
        "id": { "type": "integer" },
        "name": { "type": "string" },
        "username": { "type": "string" },
        "email": { "type": "string" },
        "address": {
            "type": "object",
            "required": ["street", "suite", "city", "zipcode", "geo"],
            "additionalProperties": true,
            "properties": {
                "street": { "type": "string" },
                "suite": { "type": "string" },
                "city": { "type": "string" },
                "zipcode": { "type": "string" },
                "geo": {
                    "type": "object",
                    "required": ["lat", "lng"],
                    "properties": {
                        "lat": { "type": "string" },
                        "lng": { "type": "string" }
                    }
                }
            }
        }
    }
}
